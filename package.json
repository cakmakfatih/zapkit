{
  "name": "zapkit-tv",
  "version": "0.1.0",
  "description": "A small React-like UI library for TV web apps: incremental-dom rendering, D-pad focus, store, router, virtual lists and a full video player.",
  "keywords": [
    "tv",
    "smart-tv",
    "d-pad",
    "spatial-navigation",
    "video-player",
    "hls",
    "dash",
    "incremental-dom",
    "tizen",
    "webos",
    "vidaa",
    "android-tv"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/cakmakfatih/zapkit-tv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cakmakfatih/zapkit-tv.git"
  },
  "bugs": {
    "url": "https://github.com/cakmakfatih/zapkit-tv/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "default": "./dist/player/index.js"
    },
    "./styles.css": "./styles/zapkit-tv.css"
  },
  "files": [
    "dist",
    "styles",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/run.mjs",
    "demo": "vite examples/demo",
    "demo:build": "vite build examples/demo",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "incremental-dom": "0.7.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "jsdom": "^25.0.0",
    "esbuild": "^0.21.5"
  }
}
